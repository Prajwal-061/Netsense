# Copy this file to .env and fill in real values.
# .env is ignored by git. Never commit real credentials.

# Lab switch reached over SSH (Netmiko)
LAB_SWITCH_HOST=192.168.x.x
LAB_SWITCH_USERNAME=changeme
LAB_SWITCH_PASSWORD=changeme

# Networks the ARP discovery scan may target, comma-separated CIDR.
# The scan refuses any subnet that is not inside one of these.
ALLOWED_SUBNETS=192.168.17.0/24

# Database (SQLAlchemy URL). Defaults to the SQLite file backend/netsense.db.
# DATABASE_URL=sqlite:////absolute/path/to/netsense.db

# Browser origins allowed to call the API (CORS), comma-separated.
# The dashboard's address. The API sends its login cookie only to these.
# CORS_ORIGINS=http://192.168.17.132:5173

# How long a dashboard login lasts, and whether the cookie needs HTTPS.
# SESSION_HOURS=8
# SESSION_COOKIE_SECURE=false
