# Copy this file to .env and fill in real values.
# .env is ignored by git. Never commit real credentials.

# Lab switch reached over SSH (Netmiko)
LAB_SWITCH_HOST=192.168.x.x
LAB_SWITCH_USERNAME=changeme
LAB_SWITCH_PASSWORD=changeme

# Networks the ARP discovery scan may target, comma-separated CIDR.
# The scan refuses any subnet that is not inside one of these.
ALLOWED_SUBNETS=192.168.17.0/24
